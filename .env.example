# =============================================================================
# Salin file ini ke `.env` lalu isi nilainya:  cp .env.example .env
# =============================================================================

# --- Endpoint OpenAI-compatible (WAJIB diisi) ---
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
OPENAI_BASE_URL=http://157.180.30.121:20128/v1
MODEL=openrouter/deepseek/deepseek-v4-flash

# --- Tuning terjemahan ---
# Jumlah kalimat per request (lebih besar = lebih sedikit request).
CHUNK_SIZE=100
# Jumlah request paralel.
CONCURRENCY=8
TEMPERATURE=0.3
# Retry per request bila gagal.
MAX_RETRIES=2
# Batas token output per request (cukup besar agar balasan tidak terpotong).
MAX_TOKENS=8192
# Batas token untuk Pass 1 (scan glossary). Outputnya JSON kecil, jadi
# cukup 1024. Adaptive retry ke MAX_TOKENS_SCAN_RETRY kalau kosong.
MAX_TOKENS_SCAN=1024
# Retry budget kalau scan pertama return content kosong (reasoning makan
# token). Cuma dipakai kalau chunk tertentu gagal — hemat vs selalu besar.
MAX_TOKENS_SCAN_RETRY=4096
# Matikan thinking/reasoning (hemat output token ~50-60% = biaya terbesar).
# Set 0 untuk mengaktifkan kembali thinking.
DISABLE_THINKING=1

# --- Cache hasil terjemahan (SQLite) ---
# Set 0 untuk menonaktifkan cache.
TRANSLATION_CACHE_ENABLED=1
# Di Docker Compose, default ini diarahkan ke named volume /data.
TRANSLATION_CACHE_PATH=/data/translations.sqlite3
# Naikkan angka ini untuk mengabaikan semua hasil cache lama.
TRANSLATION_CACHE_VERSION=1

# --- Server ---
# Port HTTP yang diekspos di host.
PORT=8000
